#!/bin/sh
# 多线路拉 manifest + ipk：对齐 luci-app-nsclient / nros-update 的 GitHub 加速列表
# 并行探测，失败忽略，取版本号最新者；同版本优先国内加速下 ipk

[ -f /usr/share/gogogo/defaults.sh ] && . /usr/share/gogogo/defaults.sh
[ -f /usr/share/gogogo/curl-resolve.sh ] && . /usr/share/gogogo/curl-resolve.sh

CPE_PKG_NAME="${CPE_PKG_NAME:-luci-app-gogogo}"
CPE_SERVICE="${CPE_SERVICE:-gogogo}"
UPDATE_MANIFEST="${CPE_UPDATE_MANIFEST:-/software/gogogo/version.json}"
GITHUB_MANIFEST_PATH="${CPE_GITHUB_MANIFEST_PATH:-main/release/version.json}"
UPDATE_LOCK="/tmp/gogogo_update.lock"
UPDATE_IPK="/tmp/gogogo_update.ipk"
CURL_TIMEOUT="${CURL_TIMEOUT:-8}"
# 与 luci-theme-gogogo nros-update-lines / nsclient chnroutes 同一组前缀
DEFAULT_MIRROR_PREFIXES="https://ghproxy.net/,https://gh-proxy.com/,https://mirror.ghproxy.com/,https://ghps.cc/,https://ghfast.top/,https://gh.llkk.cc/,https://hub.gitmirror.com/,https://gh.ddlc.top/,https://gh.noki.icu/,https://gh.sixyin.com/"

_log() {
	echo "gogogo-update: $*" >&2
}

_github_repo() {
	echo "${CPE_GITHUB_REPO:-hk59775634/luci-app-gogogo}" | sed 's|^/||;s|/*$||'
}

_legacy_mirror_prefix() {
	local m="${CPE_GITHUB_MIRROR:-}"
	[ -n "$m" ] || return 0
	echo "$m" | sed 's|/https://github.com.*||;s|/*$|/|'
}

_mirror_prefixes() {
	local p
	p="${CPE_GITHUB_MIRROR_PREFIXES:-$DEFAULT_MIRROR_PREFIXES}"
	{
		echo "$p" | tr ',' '\n'
		_legacy_mirror_prefix
	} | sed 's/^[[:space:]]*//;s/[[:space:]]*$//;s|/*$|/|' | awk 'NF && !seen[$0]++'
}

_abs_url() {
	local base="$1" path="$2"
	case "$path" in
		http://*|https://*) echo "$path" ;;
		/*) echo "${base%/}${path}" ;;
		*) echo "${base%/}/${path}" ;;
	esac
}

_wrap_github() {
	local url="$1" prefix="$2"
	[ -n "$url" ] || return 1
	case "$prefix" in
		""|direct) echo "$url" ;;
		kkgithub)
			echo "$url" | sed 's|https://github.com/|https://kkgithub.com/|'
			;;
		*)
			echo "${prefix}${url}"
			;;
	esac
}

_release_tag() {
	case "$1" in
		v*) echo "$1" ;;
		*) echo "v$1" ;;
	esac
}

_installed_version() {
	local v ctrl="/usr/lib/opkg/info/${CPE_PKG_NAME}.control"
	v=$(opkg list-installed "$CPE_PKG_NAME" 2>/dev/null | awk '{print $3}')
	[ -n "$v" ] || v=$(grep '^Version:' "$ctrl" 2>/dev/null | awk '{print $2}')
	echo "$v" | sed 's/-.*//'
}

_source_rank() {
	case "$1" in
		proxy:*) echo 5 ;;
		jsdelivr:*) echo 4 ;;
		kkgithub:*) echo 3 ;;
		github:*) echo 2 ;;
		base:*) echo 1 ;;
		*) echo 0 ;;
	esac
}

_version_gt() {
	local new="$1" old="$2"
	[ -n "$new" ] && [ -n "$old" ] || return 1
	case "$new" in
		*[!0-9]*) return 1 ;;
	esac
	case "$old" in
		*[!0-9]*) return 0 ;;
	esac
	[ "$new" -gt "$old" ] 2>/dev/null
}

_fetch_body() {
	local url="$1"
	[ -n "$url" ] || return 1
	gogogo_curl "$url" --connect-timeout "$CURL_TIMEOUT" --max-time "$((CURL_TIMEOUT * 3))" \
		--http1.1 -fsSL 2>/dev/null
}

_manifest_valid() {
	echo "$1" | jq -e '.version and .url and .sha256' >/dev/null 2>&1
}

_manifest_version() {
	echo "$1" | jq -r '.version // empty' 2>/dev/null
}

CAND_DIR=""
_cand_init() {
	CAND_DIR="/tmp/gogogo_update_cand.$$"
	rm -rf "$CAND_DIR"
	mkdir -p "$CAND_DIR"
}

_cand_add_file() {
	local src="$1" url="$2" body="$3" id="$4" compact ver
	_manifest_valid "$body" || return 1
	compact=$(echo "$body" | jq -c . 2>/dev/null) || return 1
	ver=$(_manifest_version "$compact")
	[ -n "$ver" ] || return 1
	printf '%s\n%s\n%s\n' "$src" "$compact" "$url" >"$CAND_DIR/$id"
	_log "manifest ok ($src) version=$ver"
	return 0
}

_try_manifest() {
	local src="$1" url="$2" id="$3" body
	body=$(_fetch_body "$url") || return 1
	_cand_add_file "$src" "$url" "$body" "$id"
}

_origin_manifest_urls() {
	local repo path
	repo=$(_github_repo)
	path="${GITHUB_MANIFEST_PATH#/}"
	printf '%s\n' \
		"https://github.com/${repo}/releases/latest/download/version.json" \
		"https://raw.githubusercontent.com/${repo}/${path}" \
		"https://cdn.jsdelivr.net/gh/${repo}@${path%%/*}/${path#*/}"
}

_collect_manifest_candidates() {
	local repo base m url prefix i=0 origin kind wrapped
	_cand_init
	repo=$(_github_repo)

	base=$(gogogo_get_base_url)
	if [ -n "$base" ]; then
		url=$(_abs_url "$base" "$UPDATE_MANIFEST")
		i=$((i + 1))
		_try_manifest "base:${base}" "$url" "$(printf '%03d' "$i")" &
	fi

	for origin in $(_origin_manifest_urls); do
		case "$origin" in
			*jsdelivr.net*)
				i=$((i + 1))
				_try_manifest "jsdelivr:${origin}" "$origin" "$(printf '%03d' "$i")" &
				continue
				;;
			*raw.githubusercontent.com*)
				kind="github"
				;;
			*)
				kind="github"
				;;
		esac
		i=$((i + 1))
		_try_manifest "${kind}:${origin}" "$origin" "$(printf '%03d' "$i")" &
		i=$((i + 1))
		wrapped=$(_wrap_github "$origin" "kkgithub")
		[ "$wrapped" != "$origin" ] && _try_manifest "kkgithub:${wrapped}" "$wrapped" "$(printf '%03d' "$i")" &
		for prefix in $(_mirror_prefixes); do
			i=$((i + 1))
			wrapped=$(_wrap_github "$origin" "$prefix")
			_try_manifest "proxy:${wrapped}" "$wrapped" "$(printf '%03d' "$i")" &
		done
	done
	wait

	ls "$CAND_DIR" >/dev/null 2>&1 || return 1
	set -- "$CAND_DIR"/*
	[ -f "$1" ] || return 1
	return 0
}

_pick_newest_manifest() {
	local best_src="" best_m="" best_url="" best_ver="" best_rank=0 src m url ver rank f

	for f in "$CAND_DIR"/*; do
		[ -f "$f" ] || continue
		src=$(sed -n '1p' "$f")
		m=$(sed -n '2p' "$f")
		url=$(sed -n '3p' "$f")
		[ -n "$src" ] && [ -n "$m" ] || continue
		_manifest_valid "$m" || continue
		ver=$(_manifest_version "$m")
		[ -n "$ver" ] || continue
		rank=$(_source_rank "$src")
		if [ -z "$best_ver" ] || _version_gt "$ver" "$best_ver"; then
			best_ver="$ver"
			best_src="$src"
			best_m="$m"
			best_url="$url"
			best_rank="$rank"
		elif [ "$ver" = "$best_ver" ] && [ "$rank" -gt "$best_rank" ]; then
			best_src="$src"
			best_m="$m"
			best_url="$url"
			best_rank="$rank"
		fi
	done
	rm -rf "$CAND_DIR"
	[ -n "$best_m" ] && [ -n "$best_src" ] || return 1
	_log "manifest picked ($best_src) version=$best_ver"
	printf '%s\n%s\n%s\n' "$best_m" "$best_src" "$best_url"
	return 0
}

_ipk_url_list() {
	local ver="$1" ipk_name="$2" win_url="$3" src="$4" repo tag origin prefix wrapped
	repo=$(_github_repo)
	tag=$(_release_tag "$ver")

	# 1) 与命中 manifest 同目录
	case "$win_url" in
		*version.json)
			echo "${win_url%version.json}${ipk_name}"
			;;
	esac

	# 2) base_url 相对路径
	case "$src" in
		base:*)
			echo "$(_abs_url "${src#base:}" "$ipk_name")"
			;;
	esac

	origin="https://github.com/${repo}/releases/download/${tag}/${ipk_name}"
	echo "$origin"
	echo "https://github.com/${repo}/releases/latest/download/${ipk_name}"
	echo "$(_wrap_github "$origin" "kkgithub")"
	for prefix in $(_mirror_prefixes); do
		wrapped=$(_wrap_github "$origin" "$prefix")
		echo "$wrapped"
		echo "$(_wrap_github "https://github.com/${repo}/releases/latest/download/${ipk_name}" "$prefix")"
	done
}

_uniq_urls() {
	awk 'NF && !seen[$0]++ { print }'
}

_download_ipk() {
	local ver="$1" ipk_name="$2" win_url="$3" src="$4" sha="$5" url list
	rm -f "$UPDATE_IPK"
	list="/tmp/gogogo_update_ipk_urls.$$"
	_ipk_url_list "$ver" "$ipk_name" "$win_url" "$src" | _uniq_urls >"$list"
	while read -r url; do
		[ -n "$url" ] || continue
		_log "try ipk $url"
		if gogogo_curl "$url" --connect-timeout "$CURL_TIMEOUT" --max-time 300 \
			--http1.1 -fSL -o "$UPDATE_IPK" 2>/dev/null; then
			if echo "$sha  $UPDATE_IPK" | sha256sum -c - >/dev/null 2>&1; then
				_log "ipk ok from $url"
				rm -f "$list"
				return 0
			fi
			_log "sha256 mismatch from $url"
			rm -f "$UPDATE_IPK"
		fi
	done <"$list"
	rm -f "$list" "$UPDATE_IPK"
	return 1
}

_check_update() {
	local lines manifest src_hint win_url new url sha cur

	[ "${CPE_AUTO_UPDATE:-0}" = "1" ] || {
		_log "auto update disabled"
		return 2
	}

	command -v jq >/dev/null 2>&1 || {
		_log "jq required"
		return 2
	}

	_collect_manifest_candidates || {
		_log "manifest fetch failed (all sources)"
		return 2
	}

	lines=$(_pick_newest_manifest) || {
		_log "no valid manifest from any source"
		return 2
	}
	manifest=$(echo "$lines" | sed -n '1p')
	src_hint=$(echo "$lines" | sed -n '2p')
	win_url=$(echo "$lines" | sed -n '3p')

	new=$(echo "$manifest" | jq -r '.version // empty')
	url=$(echo "$manifest" | jq -r '.url // empty')
	sha=$(echo "$manifest" | jq -r '.sha256 // empty')

	[ -n "$new" ] && [ -n "$url" ] && [ -n "$sha" ] || {
		_log "invalid manifest"
		return 2
	}

	cur=$(_installed_version)
	[ -n "$cur" ] || cur="0"

	if ! _version_gt "$new" "$cur"; then
		_log "already latest ($cur)"
		return 0
	fi

	_log "upgrade $cur -> $new"
	if ! _download_ipk "$new" "$url" "$win_url" "$src_hint" "$sha"; then
		_log "ipk download failed"
		rm -f "$UPDATE_IPK"
		return 2
	fi

	[ -x /usr/sbin/gogogo-kill ] && /usr/sbin/gogogo-kill

	if ! opkg install --force-reinstall "$UPDATE_IPK" >/dev/null 2>&1; then
		_log "opkg install failed"
		rm -f "$UPDATE_IPK"
		return 2
	fi

	rm -f "$UPDATE_IPK"

	if [ -x "/etc/init.d/${CPE_SERVICE}" ]; then
		"/etc/init.d/${CPE_SERVICE}" enable 2>/dev/null
		"/etc/init.d/${CPE_SERVICE}" start 2>/dev/null
	fi

	_log "upgraded to $new"
	return 1
}

case "${1:-check}" in
	check)
		(
			flock -n 9 || {
				_log "update in progress"
				exit 2
			}
			_check_update
		) 9>"$UPDATE_LOCK"
		;;
	*)
		echo "Usage: $0 check" >&2
		exit 2
		;;
esac
